      "code": "<template data-tp-numbering=\"\">{\"section\":{\"enabled\":true,\"maxLevel\":3,\"start\":[2,3]},\"figure\":{\"enabled\":true,\"prefix\":\"2.\",\"start\":7},\"table\":{\"enabled\":true},\"code\":{\"enabled\":true}}</template><h2 id=\"results\"><span data-section-number=\"\" data-tp-numbering-generated=\"section\">2.3 </span>Results</h2>\n<h3 id=\"detail\"><span data-section-number=\"\" data-tp-numbering-generated=\"section\">2.3.1 </span>Detail</h3>\n<figure><img src=\"http://127.0.0.1:4188/medias/image/canoe.svg\" alt=\"Diagram\"><figcaption><span data-object-number=\"figure\" data-tp-numbering-generated=\"figure\">Figure 2.7. </span>An illustration</figcaption>\n</figure>\n<table>\n<caption id=\"measurements\" style=\"caption-side: bottom\"><span data-object-number=\"table\" data-tp-numbering-generated=\"table\">Table 1. </span>Measurements</caption>\n<thead>\n<tr>\n<th>Name</th>\n<th>Value</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>A</td>\n<td>1</td>\n</tr>\n</tbody>\n</table>\n<figure>\n  <pre><code class=\"language-scheme\">(+ 1 2)\n</code></pre>\n<figcaption>\n  <p><span data-object-number=\"code\" data-tp-numbering-generated=\"code\">Code 1. </span>Calculation</p>\n\n  </figcaption>\n  \n  </figure>\n  <script data-tp-numbering-runtime=\"\">(()=>{const apply=function applyDocumentNumbering(root, config) {\n    // This function is self-contained so the same implementation can run in exported HTML.\n    const kinds = [\"section\", \"figure\", \"table\", \"code\"];\n    const positive = (n, fallback = 1) => Number.isSafeInteger(Number(n)) && Number(n) > 0 ? Number(n) : fallback;\n    if (!config) {\n        const template = root.querySelector(\"template[data-tp-numbering]\");\n        if (template) {\n            try {\n                config = JSON.parse(template.content.textContent || \"{}\");\n            }\n            catch {\n                return;\n            }\n        }\n    }\n    if (!config || !kinds.some((k) => config?.[k]?.enabled))\n        return;\n    for (const node of root.querySelectorAll(\"[data-tp-numbering-generated],template[data-tp-numbering]\"))\n        node.remove();\n    const doc = root.ownerDocument || document;\n    const meta = doc.createElement(\"template\");\n    meta.setAttribute(\"data-tp-numbering\", \"\");\n    meta.content.textContent = JSON.stringify(config);\n    root.prepend(meta);\n    const heading = config.section;\n    if (heading?.enabled) {\n        const rawMax = Number(heading.maxLevel);\n        const max = Math.min(6, Math.max(1, Number.isInteger(rawMax) ? rawMax : 6));\n        const candidate = Array.isArray(heading.start)\n            ? heading.start\n            : [positive(heading.start)];\n        const start = candidate.length > 0 &&\n            candidate.length <= max &&\n            candidate.every((n) => Number.isSafeInteger(n) && n > 0)\n            ? candidate\n            : [1];\n        const values = Array.from({ length: 6 }, (_, i) => positive(start[i], 0) - (i === start.length - 1 ? 1 : 0));\n        for (const h of root.querySelectorAll(\"h1,h2,h3,h4,h5,h6\")) {\n            const level = Number(h.localName[1]);\n            if (level > max || h.classList.contains(\"unnumbered\"))\n                continue;\n            values[level - 1] = (values[level - 1] || 0) + 1;\n            values.fill(0, level);\n            const number = (heading.prefix || \"\") +\n                values\n                    .slice(0, level)\n                    .filter((v) => v > 0)\n                    .join(\".\");\n            const span = doc.createElement(\"span\");\n            span.setAttribute(\"data-section-number\", \"\");\n            span.setAttribute(\"data-tp-numbering-generated\", \"section\");\n            span.textContent = `${number} `;\n            h.prepend(span);\n        }\n    }\n    const next = {\n        figure: positive(config.figure?.start),\n        table: positive(config.table?.start),\n        code: positive(config.code?.start),\n    };\n    for (const object of root.querySelectorAll(\"figure,table\")) {\n        const caption = object.querySelector(\":scope > caption,:scope > figcaption\");\n        if (!caption ||\n            object.classList.contains(\"unnumbered\") ||\n            caption.classList.contains(\"unnumbered\"))\n            continue;\n        const declared = object.getAttribute(\"data-numbering\");\n        const kind = declared === \"figure\" || declared === \"table\" || declared === \"code\"\n            ? declared\n            : object.localName === \"table\"\n                ? \"table\"\n                : object.querySelector(\":scope > pre\")\n                    ? \"code\"\n                    : \"figure\";\n        const rule = config[kind];\n        if (!rule?.enabled)\n            continue;\n        const value = positive(object.getAttribute(\"data-number\"), next[kind]);\n        next[kind] = value + 1;\n        const label = rule.label ?? kind[0].toUpperCase() + kind.slice(1);\n        const marker = doc.createElement(\"span\");\n        marker.setAttribute(\"data-object-number\", kind);\n        marker.setAttribute(\"data-tp-numbering-generated\", kind);\n        marker.textContent = `${(label ? `${label} ` : \"\") + (rule.prefix || \"\") + value}. `;\n        const first = caption.firstElementChild;\n        if (first?.localName === \"p\" &&\n            ![...caption.childNodes].some((n) => n.nodeType === 3 && n.textContent?.trim()))\n            first.prepend(marker);\n        else\n            caption.prepend(marker);\n    }\n};const root=document.body;const options={childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:[\"class\",\"data-number\",\"data-numbering\"]};const observer=new MutationObserver(()=>{observer.disconnect();apply(root);observer.observe(root,options);});apply(root);observer.observe(root,options);})();</script>",
