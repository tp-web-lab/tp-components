{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declarationMap": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "tests",
    "src/test-helpers",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.stories.ts",
    "src/components/*-playground/examples"
  ]
}
