{
  "name": "@tp/tp-components",
  "packageManager": "pnpm@9.15.5",
  "version": "1.0.0-rc.1",
  "description": "Web components for interactive technical and educational documents.",
  "main": "./dist/tp-lib.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tp-lib.js"
    },
    "./tp-loader": {
      "types": "./dist/tp-loader.d.ts",
      "import": "./dist/tp-loader.js"
    },
    "./tp-loader.js": {
      "types": "./dist/tp-loader.d.ts",
      "import": "./dist/tp-loader.js"
    },
    "./tp-lib.css": "./dist/tp-lib.css"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
