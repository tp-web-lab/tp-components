    "lighthouse": "pnpm test:lighthouse && pnpm lighthouse:report",
    "test:quality:pilot": "vitest run src/components/animation/animation.test.ts src/components/animation/animation-triggers.test.ts src/components/code-editor/code-editor.test.ts src/components/compare/compare.test.ts src/components/modal/modal.test.ts src/components/modal/modal-triggers.test.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=json-summary --coverage.include='src/components/{animation,code-editor,compare,modal}/*.ts' --coverage.exclude='src/**/*.test.ts' --coverage.reportsDirectory=config/quality-coverage",
    "quality:report": "node scripts/generate-component-quality-report.mjs",
    "quality:report:check": "node scripts/generate-component-quality-report.mjs --check",
    "quality:pilot": "pnpm test:quality:pilot && pnpm quality:report",
    "test:quality:layouts": "vitest run src/components/{accordion,box,card,flip-card,center,cluster,cover,grid,frame,inline,menu,sidebar,slider,splitter,stack,switcher,tabs,timeline,toc,toolbar,tree}/*.test.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=json-summary --coverage.include='src/components/{accordion,box,card,flip-card,center,cluster,cover,grid,frame,inline,menu,sidebar,slider,splitter,stack,switcher,tabs,timeline,toc,toolbar,tree}/*.ts' --coverage.exclude='src/**/*.test.ts' --coverage.reportsDirectory=config/layout-quality-coverage",
