    "test:quality:controllers": "vitest run src/components/{dir,color,fullscreen,lang,theme}/*.test.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=json-summary --coverage.include='src/components/{dir,color,fullscreen,lang,theme}/*.ts' --coverage.exclude='src/**/*.test.ts' --coverage.reportsDirectory=config/controllers-quality-coverage",
    "quality:controllers:report": "node scripts/generate-controllers-quality-report.mjs",
    "quality:controllers:check": "node scripts/generate-controllers-quality-report.mjs --check",
