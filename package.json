    "quality:utilities:report": "node scripts/generate-utilities-quality-report.mjs",
    "quality:utilities:check": "node scripts/generate-utilities-quality-report.mjs --check",
    "quality:utilities": "pnpm test:quality:utilities && pnpm quality:utilities:report && pnpm quality:report",
    "test:quality:time": "vitest run src/components/{alarm,clock,chronometer,timer}/*.test.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=json-summary --coverage.include='src/components/{alarm,clock,chronometer,timer}/*.ts' --coverage.exclude='src/**/*.test.ts' --coverage.reportsDirectory=config/time-quality-coverage",
    "quality:time:report": "node scripts/generate-time-quality-report.mjs",
    "quality:time:check": "node scripts/generate-time-quality-report.mjs --check",
    "quality:time": "pnpm test:quality:time && pnpm quality:time:report && pnpm quality:report",
    "test:quality:overlays": "vitest run src/components/{contextmenu,dialog,drawer,dropdown,modal,popover,tooltip}/*.test.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=json-summary --coverage.include='src/components/{contextmenu,dialog,drawer,dropdown,modal,popover,tooltip}/*.ts' --coverage.exclude='src/**/*.test.ts' --coverage.reportsDirectory=config/overlays-quality-coverage",
