{
  "tagname": "tp-console",
  "classname": "TpConsole",
  "superclass": "TpBase",
  "description": "Visual console for playground output.",
  "examples": [
    {
      "label": "Example 1",
      "code": "<tp-box data-intro-action=\"console\" data-allow-script>\n  <p>Inspect these example messages, then use Clear to empty the console.</p>\n  <tp-console></tp-console>\n  <p data-demo-status role=\"status\"></p>\n  <script src=\"/tp-components/docs/components/_shared/introduction-actions.js\"></script>\n</tp-box>"
    }
  ],
  "attributes": [],
  "methods": [
    {
      "name": "addEntry(kind: TpConsoleEntryKind, values: TpConsoleValue[]): TpConsoleEntry",
      "inherited": false,
      "description": "Adds an entry to the console."
    },
    {
      "name": "assert(condition: unknown, ...values: TpConsoleValue[]): void",
      "inherited": false,
      "description": "Writes an assertion failure."
    },
    {
      "name": "clear(): void",
      "inherited": false,
      "description": "Removes all entries."
    },
    {
      "name": "count(label = \"default\"): void",
      "inherited": false,
      "description": "Writes a counter value."
    },
    {
      "name": "countReset(label = \"default\"): void",
      "inherited": false,
      "description": "Resets a counter."
    },
    {
      "name": "error(...values: TpConsoleValue[]): void",
      "inherited": false,
      "description": "Writes an error entry."
    },
    {
      "name": "getEntries(): TpConsoleEntry[]",
      "inherited": false,
      "description": "Returns a copy of the displayed entries."
    },
    {
      "name": "getValue(): string",
      "inherited": false,
      "description": "Returns the text copied by the toolbar copy button."
    },
    {
      "name": "group(...values: TpConsoleValue[]): void",
      "inherited": false,
      "description": "Starts an expanded group."
    },
    {
      "name": "groupCollapsed(...values: TpConsoleValue[]): void",
      "inherited": false,
      "description": "Starts a collapsed group."
    },
    {
      "name": "groupEnd(): void",
      "inherited": false,
      "description": "Ends the current group."
    },
    {
      "name": "info(...values: TpConsoleValue[]): void",
      "inherited": false,
      "description": "Writes an informational entry."
    },
    {
      "name": "log(...values: TpConsoleValue[]): void",
      "inherited": false,
      "description": "Writes a standard entry."
    },
    {
      "name": "redirectConsoleToSelf(): () => void",
      "inherited": false,
      "description": "Redirects global console calls to this component."
    },
    {
      "name": "restoreConsole(): void",
      "inherited": false,
      "description": "Restores the original global console methods."
    },
    {
      "name": "table(...values: TpConsoleValue[]): void",
      "inherited": false,
      "description": "Writes tabular data."
    },
    {
      "name": "time(label = \"default\"): void",
      "inherited": false,
      "description": "Starts a timer."
    },
    {
      "name": "timeEnd(label = \"default\"): void",
      "inherited": false,
      "description": "Ends a timer."
    },
    {
      "name": "timeLog(label = \"default\", ...values: TpConsoleValue[]): void",
      "inherited": false,
      "description": "Writes a timer value."
    },
    {
      "name": "warn(...values: TpConsoleValue[]): void",
      "inherited": false,
      "description": "Writes a warning entry."
    }
  ],
  "events": [
    {
      "name": "tp-console-clear",
      "description": "Emitted when the console is cleared.",
      "detail": "{ removedCount: number }"
    },
    {
      "name": "tp-console-entry-add",
      "description": "Emitted when an entry is added.",
      "detail": "{ entry: TpConsoleEntry }"
    }
  ],
