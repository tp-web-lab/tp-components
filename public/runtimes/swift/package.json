{
  "name": "@live-codes/swift-wasm",
  "version": "0.1.0",
  "description": "Client-side Swift for LiveCodes: compile and run Swift in the browser with no server, using the wasm-hosted Swift toolchain (swift-frontend + wasm-ld).",
  "keywords": [
    "swift",
    "webassembly",
    "wasm",
    "wasi",
    "compiler",
    "playground",
    "livecodes"
  ],
  "homepage": "https://github.com/live-codes/browser-swift#readme",
  "bugs": {
    "url": "https://github.com/live-codes/browser-swift/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/live-codes/browser-swift.git"
  },
  "type": "module",
  "license": "MIT",
  "main": "dist/swift-wasm.iife.js",
  "files": [
    "dist",
    "toolchain",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fetch": "node scripts/fetch-toolchain.mjs",
    "spike": "node scripts/spike.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/smoke.mjs",
    "check-package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run check-package"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=20"
  }
}
